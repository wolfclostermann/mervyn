# Oracle Cloud (OCI) stack — default Terraform root under terraform/.
# Composable-module layout aligns with https://github.com/gfs-sre/terraform-framework-example-stack
#
# AWS: use terraform/stacks/aws/ (separate root; see scripts/bootstrap.sh aws).
#
# Copy to terraform.tfvars (gitignored), fill in secrets, then encrypt like .env.enc:
#   cp terraform/terraform.tfvars.example terraform/terraform.tfvars
#   ENV_FILE=terraform/terraform.tfvars ./scripts/env-crypto.sh encrypt
# Commit terraform/terraform.tfvars.enc only.
# Decrypt before plan/apply:
#   ENV_FILE=terraform/terraform.tfvars ./scripts/env-crypto.sh decrypt

# --- Identity (replace with your values) ---
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaa..."
user_ocid        = "ocid1.user.oc1..aaaaaaaa..."
api_fingerprint  = "aa:bb:cc:..."
private_key_path = "/Users/you/.oci/oci_api_key.pem"

region           = "uk-london-1"
compartment_ocid = "ocid1.compartment.oc1..aaaaaaaa..."

# Must match the SSH public key on the instance (metadata) when managing an imported VM.
ssh_public_key = "ssh-rsa AAAA... or ssh-ed25519 AAAA... you@host"

# --- Stack aligned with import + live resources (see scripts/terraform-import-oci-from-instance.sh) ---
# VCN/subnet/SL names: mervyn-vcn, mervyn-public, mervyn-public-sl; instance display name mervyn-1; AD ccuG:UK-LONDON-1-AD-2

project_name = "mervyn"

availability_domain_index = 1

instance_shape           = "VM.Standard.E2.1.Micro"
instance_ocpus           = 1
instance_memory_gbs      = 1
instance_source_image_id = "ocid1.image.oc1.uk-london-1.aaaaaaaapkaf5prv2ub3i25ccsnhbzzrcg5t3fq6ate2wfhpr2y7j2mc5pqa"
instance_display_name    = "mervyn-1"
ssh_user                 = "opc"
bootstrap_docker         = false

# cloud-init in this repo targets Ubuntu; this image is Oracle Linux 9 — install Docker by hand or switch to Ubuntu ARM.

# Optional: lock SSH to your IP
# ssh_allowed_cidrs = ["203.0.113.10/32"]

# Optional: expose Mervyn on 3000 from the internet
# expose_app_port = true

# --- Fresh Ampere / Ubuntu alternative (disable the block above and use this instead) ---
# project_name              = "mervyn"
# availability_domain_index = 0
# instance_shape            = "VM.Standard.A1.Flex"
# instance_ocpus            = 1
# instance_memory_gbs       = 6
# instance_source_image_id  = ""
# instance_display_name     = ""
# ssh_user                  = "ubuntu"
# bootstrap_docker          = true

# Import existing OCI resources into state:
#   scripts/terraform-import-oci-from-instance.sh '<instance-ocid>' mervyn
