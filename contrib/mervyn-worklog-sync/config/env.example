# Copy to:   ~/.config/mervyn-worklog/env
# Use only assign forms below with export so subprocesses (python3) see optional flags.

# Your clone of the Mervyn vault repo, which holds worklog.md alongside events.md and todos.md.
# This is the same directory Obsidian opens. (Before 2026-09-17 this was a separate worklog repo.)
export MERVYN_WORKLOG_REPO="$HOME/Projects/mervyn-vault"

# Path inside that repo to the file Mervyn reads as vault worklog.
export MERVYN_WORKLOG_REL_PATH="worklog.md"

# Only post-commit in repos under these roots (space-separated). No spaces inside paths.
# Example: every repo under ~/Projects. The hook exits quietly if this does not match, so keep it
# current — a stale prefix looks the same as having nothing worth logging.
export MERVYN_WORKLOG_PROJECT_PREFIXES="$HOME/Projects"

# Optional: use UTC for ## YYYY-MM-DD section headings (default: local date).
# export MERVYN_WORKLOG_UTC_DATE=1

# Optional: commit locally but do not push (e.g. offline); push later from worklog repo.
# export MERVYN_WORKLOG_SKIP_PUSH=1

# Optional: if append-worklog-line.py is not next to post-commit in core.hooksPath.
# export MERVYN_WORKLOG_APPEND_SCRIPT="$HOME/dotfiles/git/hooks/append-worklog-line.py"
