ANTHROPIC_API_KEY=sk-ant-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Channel where Mervyn posts briefings and reminders
SLACK_CHANNEL_ID=C...

# Optional: enables GET /admin/slack-ingest (Bearer token). Omit in production if unused.
# MERVYN_ADMIN_TOKEN=
# Optional: required only when [ngrok].enabled=true (or MERVYN__NGROK__ENABLED=true)
# NGROK_AUTHTOKEN=

# Optional: override values from config/default.toml (use __ between nested keys):
# MERVYN__SERVER__PORT=8080
# MERVYN__NGROK__ENABLED=true
# MERVYN__NGROK__DOMAIN=example.ngrok.app
# MERVYN__STORAGE__VAULT_PATH=/data/vault
# MERVYN__STORAGE__SLACK_INGEST_RETENTION_DAYS=90
# MERVYN__STORAGE__SLACK_INGEST_KEEP_LAST=100000
# MERVYN__STORAGE__SLACK_INGEST_STALE_PENDING_MINUTES=30
# MERVYN__SCHEDULER__TIMEZONE=Europe/London
# MERVYN__SCHEDULER__SLACK_INGEST_PRUNE_CRON="0 0 4 * * *"
# Optional: standing context for Claude (Markdown under vault). Disable with MERVYN__USER_CONTEXT__ENABLED=false
# MERVYN__USER_CONTEXT__SITUATION_FILE=mervyn-situation.md
# MERVYN__USER_CONTEXT__SITUATION_MAX_CHARS=12000
