ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456789:AA...
# The ONLY chat Mervyn answers, and where briefings and reminders go.
# Numeric id (negative for groups). DM the bot once, then read it from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Optional: enables GET /admin/message-ingest (Bearer token). Omit in production if unused.
# MERVYN_ADMIN_TOKEN=

# Optional: override values from config/default.toml (use __ between nested keys):
# MERVYN__SERVER__PORT=8080
# MERVYN__STORAGE__VAULT_PATH=/data/vault
# MERVYN__STORAGE__MESSAGE_INGEST_RETENTION_DAYS=90
# MERVYN__STORAGE__MESSAGE_INGEST_KEEP_LAST=100000
# MERVYN__STORAGE__MESSAGE_INGEST_STALE_PENDING_MINUTES=30
# MERVYN__SCHEDULER__TIMEZONE=Europe/London
# MERVYN__SCHEDULER__MESSAGE_INGEST_PRUNE_CRON="0 0 4 * * *"
# Optional: standing context for Claude (Markdown under vault). Disable with MERVYN__USER_CONTEXT__ENABLED=false
# MERVYN__USER_CONTEXT__SITUATION_FILE=mervyn-situation.md
# MERVYN__USER_CONTEXT__SITUATION_MAX_CHARS=12000
# Optional: git sync of the vault clone while Mervyn runs (see [vault_git] in config/default.toml)
# Vault git sync — carries the vault to a laptop and a phone (see docs/two-way-vault-sync.md).
# The vault directory is the git working tree; these override config/default.toml's [vault_git].
# MERVYN__VAULT_GIT__ENABLED=true
# MERVYN__VAULT_GIT__REMOTE=origin
# MERVYN__VAULT_GIT__BRANCH=main
# MERVYN__VAULT_GIT__SYNC_CRON="0 */5 * * * *"
# Private GitHub remote (Docker / no TTY): OAuth token from `gh auth token` or a PAT. Pushing
# needs **write** access, where the old worklog pull only needed read. Used as the git password
# with user x-access-token. Never commit this line.
# MERVYN_VAULT_GITHUB_PAT=

# Vault write-back (db → Markdown). Off by default; see docs/two-way-vault-sync.md.
# The deployed host sets this in docker-compose.yml's `environment:` block instead — it is not a
# secret, and putting it there means it survives a deploy that decrypts a stale .env.enc.
# With it on, reminders/events/todos added from chat are written into the vault, edits in
# Obsidian reach the database, and the managed files are backed up before the first write
# of each run. worklog.md is never written.
# MERVYN__VAULT__WRITE_BACK_ENABLED=true
# MERVYN__VAULT__BACKUP_BEFORE_FIRST_WRITE=false
