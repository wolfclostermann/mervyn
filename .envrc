# direnv: scope `gh` CLI operations (pr/issue create, `gh api`, CI-adjacent lookups) in this
# repo to the personal GitHub account, without changing your global `gh auth switch` state.
# Requires: direnv (https://direnv.net) + `gh auth login -h github.com -u wolfclostermann` once.
export GH_TOKEN="$(gh auth token -h github.com -u wolfclostermann 2>/dev/null)"
